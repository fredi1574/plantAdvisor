# FloraLog Environment Configuration
# Set to "true" to use the built-in botanical mock AI engine (100% local & offline-ready).
# Set to "false" and provide EXPO_PUBLIC_GEMINI_API_KEY to use live Gemini Multimodal AI.
EXPO_PUBLIC_USE_MOCK_AI=true
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

